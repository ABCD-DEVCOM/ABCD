                                if v720^b = 'v.m.d.'  then 'Dos - Cadre - Droit' fi
                                if v720^b = 'v.m.ab.' then 'Dos - Cadre - Bas' fi
                                if v720^b = 'f.f.'   then 'Face Avant' fi
                                if v720^b = 'f.p.'   then 'Face Arrière' fi
                                if v720^b = 'f.s.'   then 'Face Supérieure' fi
                                if v720^b = 'f.i.'   then 'Face Inférieure' fi
                                if v720^b = 'f.l.e.' then 'Face Latérale Gauche' fi
                                if v720^b = 'f.l.d.' then 'Face Latérale Droite' fi
