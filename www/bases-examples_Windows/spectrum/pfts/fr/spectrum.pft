                    if p(v230^c) then '<span class="dim-tag">Prof: <b>'v230^c'</b></span>' fi
                    if p(v230^d) then '<span class="dim-tag">Diam: <b>'v230^d'</b></span>' fi
                    if a(v230^a) then v230 fi
                    '</td></tr>' 
                fi
                
                if p(v240) then '<tr><th>Dimensions du Support</th><td>'v240+|<br>|,'</td></tr>' fi
                if p(v250) then '<tr><th>Poids</th><td>'v250+|<br>|,'</td></tr>' fi
                '</table>'
            fi

            if p(v300) or p(v330) then
