    '<div class="museum-body">'

        ''
        '<div class="museum-content">'

            '<h3 class="section-title"><i class="fas fa-fingerprint"></i> Identification et Classification</h3>'
            ' <table class="museum-table">'
                if p(v001) then '<tr><th>ID Provisoire/Ancien</th><td>'v001+|<br>|,'</td></tr>' fi
                if p(v020) then '<tr><th>Classification</th><td>'v020+|<br>|,'</td></tr>' fi
                if p(v060) then '<tr><th>Catégorie / Typologie</th><td>'v060+|<br>|,'</td></tr>' fi
                if p(v030) then '<tr><th>Nombre des Éléments</th><td>'v030+|<br>|,'</td></tr>' fi
