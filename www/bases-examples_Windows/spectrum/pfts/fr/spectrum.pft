                if p(v300) then '<tr><th>Auteur / Artiste</th><td><strong>'v300+|<br>|,'</strong></td></tr>' fi
                if p(v310) then '<tr><th>Fabricant</th><td>'v310+|<br>|,'</td></tr>' fi
                if p(v330) then '<tr><th>Période/Date de Création</th><td><i class="far fa-calendar-alt"></i> 'v330+|<br>|,'</td></tr>' fi
                if p(v340) then '<tr><th>Lieu/Forme de Production</th><td>'v340+|<br>|,'</td></tr>' fi
                if p(v320) then '<tr><th>Note Biographique</th><td>'v320+|<br>|,'</td></tr>' fi
                '</table>'
            fi

            if p(v400) or p(v410) then
                '<h3 class="section-title"><i class="fas fa-box-open"></i> Provenance et Acquisition</h3>
                <table class="museum-table">'
                if p(v400) then '<tr><th>Provenance</th><td>'v400+|<br>|,'</td></tr>' fi
                if p(v430) then '<tr><th>Méthode Acquisition</th><td>'v430+|<br>|,'</td></tr>' fi
                if p(v410) then '<tr><th>Date de Réception</th><td>'v410+|<br>|,'</td></tr>' fi
                if p(v420) then '<tr><th>Valeur</th><td>'v420+|<br>|,'</td></tr>' fi
                '</table>'
            fi

