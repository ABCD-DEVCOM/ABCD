                                if v720^b = 'int.f.f'   then 'Interne - Face Avant' fi
                                if v720^b = 'int.f.p'   then 'Interne - Face Arrière' fi
                                if v720^b = 'int.f.s'   then 'Interne - Face Supérieure' fi
                                if v720^b = 'int.f.i'   then 'Interne - Face Inférieure' fi
                                if v720^b = 'int.f.l.e' then 'Interne - Face Latérale Gauche' fi
                                if v720^b = 'int.f.l.d' then 'Interne - Face Latérale Droite' fi
                                if a(v720^b) then '' else if v720^b : '.' then '' else v720^b fi fi

                                '</span>
                                <span class="insc-texto">Transcr: <strong>'v720^t'</strong></span>
                             </div>'
                        )
                        '</td>
                    </tr>' 
                fi
                '</table>'
            fi

            '<h3 class="section-title"><i class="fas fa-map-marked-alt"></i> Localisation et Contrôle</h3>'
            '<table class="museum-table">'
            if p(v800) then '<tr><th>Localisation Actuelle</th><td><strong>'v800+|<br>|,'</strong></td></tr>' fi
            if p(v810) then '<tr><th>Historique des Emplacements</th><td>'v810+|<br>|,'</td></tr>' fi
            if p(v820) then '<tr><th>Pièces Jointes</th><td>'v820+|<br>|,'</td></tr>' fi
            if p(v821) then '<tr><th>Pièces Jointes Publiques</th><td>'v821+|<br>|,'</td></tr>' fi
            if p(v870) then '<tr><th>Remarques Générales</th><td>'v870+|<br>|,'</td></tr>' fi
            if p(v890) then '<tr><th>Dernière Mise à Jour</th><td><small>'(v890'<br>')'</small></td></tr>' fi
            '</table>'

        '</div>' ''

        if p(v820) then 
            '<div class="museum-sidebar">'
                '<h3 class="section-title"><i class="far fa-images"></i> Médias</h3>'
                (
                    '<a href="../common/show_image.php?image='v820'&base=spectrum" target="_blank" class="gallery-item">'
                        '<img src="../common/show_image.php?image='v820'&base=spectrum" alt="Image associée à la notice">'
                    '</a>'
                /)
            '</div>'
        fi

