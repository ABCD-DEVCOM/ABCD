            '</table>'

            if p(v100) or p(v110) or p(v120) then
                '<h3 class="section-title"><i class="fas fa-eye"></i> Description Visuelle</h3>
                <table class="museum-table">'
                if p(v100) then '<tr><th>Description Sommaire</th><td>'v100+|<br>|,'</td></tr>' fi
                if p(v110) then '<tr><th>Description Analytique</th><td>'v110+|<br>|,'</td></tr>' fi
                if p(v120) then '<tr><th>Marques Physiques</th><td>'v120+|<br>|,'</td></tr>' fi
                '</table>'
            fi

            if p(v200) or p(v220) or p(v230) then
