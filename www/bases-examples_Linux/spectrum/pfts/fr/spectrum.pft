                if p(v240) then '<tr><th>Dimensions du Support</th><td>'v240+|<br>|,'</td></tr>' fi
                if p(v250) then '<tr><th>Poids</th><td>'v250+|<br>|,'</td></tr>' fi
                '</table>'
            fi

            if p(v300) or p(v330) then
                '<h3 class="section-title"><i class="fas fa-user-edit"></i> Création et Production</h3>
                <table class="museum-table">'
                if p(v300) then '<tr><th>Auteur / Artiste</th><td><strong>'v300+|<br>|,'</strong></td></tr>' fi
                if p(v310) then '<tr><th>Fabricant</th><td>'v310+|<br>|,'</td></tr>' fi
