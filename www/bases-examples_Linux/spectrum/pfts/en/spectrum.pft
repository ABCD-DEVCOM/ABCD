                                if v720^b = 'f.c.s.d.' then 'Front - Top Right Corner' fi
                                if v720^b = 'f.c.e.'   then 'Front - Center Left' fi
                                if v720^b = 'f.c.'     then 'Front - Center' fi
                                if v720^b = 'f.c.d.'   then 'Front - Center Right' fi
                                if v720^b = 'f.c.i.e.' then 'Front - Bottom Left Corner' fi
                                if v720^b = 'f.ab.c.'  then 'Front - Bottom Center' fi
