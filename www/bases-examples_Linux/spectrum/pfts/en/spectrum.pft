                                if v720^b = 'v.c.d.'   then 'Back - Center Right' fi
                                if v720^b = 'v.c.i.e.' then 'Back - Bottom Left Corner' fi
                                if v720^b = 'v.i.c'    then 'Back - Bottom Center' fi
                                if v720^b = 'v.c.i.d'  then 'Back - Bottom Right Corner' fi
                                if v720^b = 'chassi ac.' then 'Stretcher - Top' fi
                                if v720^b = 'chassi ab.' then 'Stretcher - Bottom' fi
                                if v720^b = 'chassi e.'  then 'Stretcher - Left' fi
                                if v720^b = 'chassi d.'  then 'Stretcher - Right' fi
                                if v720^b = 'v.m.ac.' then 'Back - Frame - Top' fi
                                if v720^b = 'v.m.e.'  then 'Back - Frame - Left' fi
                                if v720^b = 'v.m.d.'  then 'Back - Frame - Right' fi
