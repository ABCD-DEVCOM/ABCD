                                if v720^b = 'm.e.'  then 'Frame - Left' fi
                                if v720^b = 'm.d.'  then 'Frame - Right' fi
                                if v720^b = 'v.c.s.e'  then 'Back - Top Left Corner' fi
                                if v720^b = 'v.ac.c.'  then 'Back - Top Center' fi
                                if v720^b = 'v.c.s.d'  then 'Back - Top Right Corner' fi
