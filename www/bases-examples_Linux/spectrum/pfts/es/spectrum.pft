                if p(v330) then '<tr><th>Fecha/Período de Creación</th><td><i class="far fa-calendar-alt"></i> 'v330+|<br>|,'</td></tr>' fi
                if p(v340) then '<tr><th>Lugar de Producción</th><td>'v340+|<br>|,'</td></tr>' fi
